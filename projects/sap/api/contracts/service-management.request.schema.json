{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liberu:proposed:enterprise:service-management:resolve:request:v1",
  "title": "Service management: proposed resolve request",
  "description": "Draft enterprise request contract, not an implemented or released API guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_code",
    "resolution_summary",
    "evidence_references",
    "change_reference"
  ],
  "properties": {
    "resolution_code": {
      "type": "string",
      "minLength": 1
    },
    "resolution_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
