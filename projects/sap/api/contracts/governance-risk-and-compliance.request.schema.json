{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liberu:proposed:enterprise:governance-risk-and-compliance:record-finding:request:v1",
  "title": "Governance, risk and compliance: proposed record-finding request",
  "description": "Draft enterprise request contract, not an implemented or released API guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "control_reference",
    "finding_summary",
    "evidence_references",
    "remediation_owner_reference",
    "due_at"
  ],
  "properties": {
    "control_reference": {
      "type": "string",
      "minLength": 1
    },
    "finding_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remediation_owner_reference": {
      "type": "string",
      "minLength": 1
    },
    "due_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
