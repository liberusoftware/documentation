{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liberu:proposed:enterprise:inventory-and-logistics:receive:request:v1",
  "title": "Inventory and logistics: proposed receive request",
  "description": "Draft enterprise request contract, not an implemented or released API guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_reference",
    "destination_location_id",
    "received_at",
    "lines"
  ],
  "properties": {
    "receipt_reference": {
      "type": "string",
      "minLength": 1
    },
    "destination_location_id": {
      "type": "string",
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_reference",
          "quantity",
          "unit",
          "lot_reference",
          "condition"
        ],
        "properties": {
          "item_reference": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "lot_reference": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
