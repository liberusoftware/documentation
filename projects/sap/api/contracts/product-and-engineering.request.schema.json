    },
    "test_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vulnerability_review_id": {
      "type": "string",
      "minLength": 1
    },
    "rollout_plan_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
